    {
      "__type": "com.ai.assistance.operit.data.model.ExecuteNode",
      "id": "exec_verify",
      "name": "验工(比账本时间戳)",
      "position": {
        "x": 100,
        "y": 2600
      },
      "actionType": "super_admin:shell",
      "actionConfig": {
        "command": {
          "__type": "com.ai.assistance.operit.data.model.ParameterValue.StaticValue",
          "value": "S=/sdcard/Download/Operit/.wfguard/trip_start; B=/sdcard/Download/Operit/闲逛手记/data.json; ST=$(cat \"$S\" 2>/dev/null || echo 0); if [ -z \"$ST\" ]; then ST=0; fi; if [ \"$ST\" -le 0 ] 2>/dev/null; then echo NO_START; exit 1; fi; LR=$(grep -o '\"last_run_at\"[^,}]*' \"$B\" 2>/dev/null | grep -o '[0-9][0-9]*' | head -1); if [ -n \"$LR\" ] && [ \"$LR\" -gt \"$ST\" ] 2>/dev/null; then echo OK_LEDGER; exit 0; fi; MD=/sdcard/Download/Operit/闲逛手记/$(date +%Y-%m-%d).md; if [ -f \"$MD\" ]; then MT=$(stat -c %Y \"$MD\"); MT=$(( MT * 1000 )); if [ \"$MT\" -gt \"$ST\" ] 2>/dev/null; then echo OK_MD; exit 0; fi; fi; echo NONE; exit 1"
        }
      },
      "description": "拿 last_run_at 跟本趟开始时间比，真落了账才算成，md 兜底"
    },

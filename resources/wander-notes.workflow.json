{
  "name": "📱 闲逛手记",
  "description": "每 N 小时醒一次（09:00-23:00）。该跑吗三合一放行 → 读账本 → 找对话 → 逛一次 → 比账本时间戳验工 → 收工或推通知。",
  "enabled": true,
  "nodes": [
    {
      "__type": "com.ai.assistance.operit.data.model.TriggerNode",
      "id": "trigger_sched",
      "name": "定时触发",
      "position": {
        "x": 120,
        "y": -480
      },
      "triggerType": "schedule",
      "triggerConfig": {
        "schedule_type": "interval",
        "interval_ms": "36000000",
        "repeat": "true",
        "enabled": "true"
      }
    },
    {
      "__type": "com.ai.assistance.operit.data.model.TriggerNode",
      "id": "trigger_manual",
      "name": "手动触发(测试用)",
      "position": {
        "x": -1320,
        "y": -600
      },
      "triggerType": "manual",
      "triggerConfig": {
        "enabled": "true"
      }
    },
    {
      "__type": "com.ai.assistance.operit.data.model.ExecuteNode",
      "id": "exec_gate",
      "name": "该跑吗(窗口+防抖+催逛)",
      "position": {
        "x": -800,
        "y": -200
      },
      "actionType": "super_admin:shell",
      "actionConfig": {
        "command": {
          "__type": "com.ai.assistance.operit.data.model.ParameterValue.StaticValue",
          "value": "D=/sdcard/Download/Operit/.wfguard; mkdir -p \"$D\" 2>/dev/null || true; F=\"$D/wander.ts\"; S=\"$D/trip_start\"; N=$(date +%s); B=/sdcard/Download/Operit/闲逛手记/data.json; H=$(date +%H); if [ \"$H\" -lt 9 ] || [ \"$H\" -ge 23 ]; then echo SKIP_WINDOW; exit 0; fi; M=0; if [ -f \"$B\" ]; then if ! grep -q '\"manual_request\": *' \"$B\" 2>/dev/null; then M=1; fi; fi; HH=$(grep -o '\"interval_hours\"[^,}]*' \"$B\" 2>/dev/null | grep -o '[0-9][0-9.]*' | head -1); if [ -z \"$HH\" ]; then HH=6; fi; HI=${HH%.*}; TH=$(( HI * 3600 * 66 / 100 )); L=0; if [ -f \"$F\" ]; then L=$(cat \"$F\" 2>/dev/null || echo 0); fi; if [ \"$M\" = \"0\" ] && [ \"$L\" -gt 0 ] 2>/dev/null && [ $((N-L)) -lt $TH ]; then echo SKIP_GUARD; exit 0; fi; echo \"$N\" > \"$F\" 2>/dev/null || true; echo \"$(( N * 1000 ))\" > \"$S\" 2>/dev/null || true; echo RUN; exit 0"
        }
      },
      "description": "三合一：白天窗口、重启防抖、手动催逛。放行输出 RUN，并把本趟开始时间写进 .wfguard/trip_start"
    },
